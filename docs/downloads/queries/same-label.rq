# Which labels occur in more than one instance?
# Equal names are reported and never merged: the registry only states that two
# entries share a label, not that they are the same thing. Whether <em>Florian
# Thiery</em> in both instances is one person is for a person to say.

PREFIX bbr: <https://beaverbridge-framework.github.io/beaverbridge-registry/vocab/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT ?label ?a ?x ?b ?y WHERE {
  ?x rdfs:label ?label ;
     bbr:fromInstance/bbr:prefix ?a .
  ?y rdfs:label ?label ;
     bbr:fromInstance/bbr:prefix ?b .
  FILTER(?a < ?b && LANG(?label) = "en")
}
ORDER BY ?label
